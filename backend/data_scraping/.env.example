# News Scraper Environment Configuration
# Copy this file to .env in backend/data_scraping/.
# Values here can override backend/.env when needed.

# Database Configuration
# Preferred DB setup (shared with FastAPI app)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=quantum
POSTGRES_PORT=5432

# Optional explicit DB URL override for scraper only
# DATABASE_URL=postgresql://postgres:password@localhost:5432/quantum

# Optional SQLAlchemy style URL override (will be normalized for asyncpg)
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:password@localhost:5432/quantum

# DB pool tuning
DB_POOL_MIN=5
DB_POOL_MAX=20

# Embedding Configuration
# Default local lookup order:
# 1) EMBEDDING_MODEL_PATH (if set and exists)
# 2) backend/bge_model/bge-base-en-v1.5
# 3) backend/data_scraping/models/bge-base-en-v1.5
# 4) Hugging Face fallback: BAAI/bge-base-en-v1.5
# EMBEDDING_MODEL_PATH=d:/Quantum/backend/bge_model/bge-base-en-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8

# Scraping Configuration
SCRAPING_TIMEOUT_SECONDS=30
SCRAPING_DELAY_SECONDS=3
SCRAPING_MAX_RETRIES=3
SCRAPING_CONCURRENT_REQUESTS=5
MAX_ARTICLES_PER_SOURCE=50

# ============================================================================
# SCHEDULING CONFIGURATION - Parallel Independent Tasks
# ============================================================================
# All tasks run independently and concurrently (no blocking between them)
#
# Scraping interval in MINUTES (how often to check for new articles)
# Default: 10 minutes (changed from 6 hours for more frequent updates)
# Development: 1-2 minutes for testing
# Production: 30-60 minutes for optimized load
SCRAPING_INTERVAL_MINUTES=10

# Embedding interval in MINUTES (how often to generate vectors for new articles)
# Default: 10 minutes (changed from 30 minutes for faster processing)
# Development: 1-5 minutes for testing
# Production: 15-30 minutes balanced with scraping
EMBEDDING_INTERVAL_MINUTES=10

# API news interval in MINUTES (general/world/war-related pipeline)
# This runs independently from scraping and embeddings
API_NEWS_INTERVAL_MINUTES=15

# Cleanup interval in HOURS (how often to remove old scraping records)
# Default: 24 hours (changed from 7 days for more frequent cleanup)
# Keeps at least 30 days of records based on database settings
CLEANUP_INTERVAL_HOURS=24

# Run immediately on startup (true/false)
# If true: all tasks run immediately before waiting for first interval
# If false: tasks wait for their interval before first run
# Default: true (ensures fresh data on application restart)
RUN_ON_STARTUP=true

# ============================================================================
# API NEWS INGESTION CONFIGURATION
# ============================================================================
# Enable API pipeline for non-BBC/AlJazeera/Guardian general and war-related news
API_NEWS_ENABLED=true

# News API key (required for API pipeline)
NEWS_API_KEY=

# Optional provider/base URL override (default uses NewsAPI everything endpoint)
# NEWS_API_BASE_URL=https://newsapi.org/v2/everything

# API request tuning
API_NEWS_TIMEOUT_SECONDS=30
API_NEWS_PAGE_SIZE=40
API_NEWS_LOOKBACK_DAYS=2
API_NEWS_LANGUAGE=en
API_NEWS_SORT_BY=publishedAt

# Optional comma-separated domain overrides
# API_NEWS_DOMAINS=reuters.com,apnews.com,nytimes.com,washingtonpost.com
# API_NEWS_EXCLUDE_DOMAINS=bbc.com,aljazeera.com,theguardian.com,newsbtc.com,cryptoslate.com,ambcrypto.com,blockonomi.com,decrypt.co,cnbc.com

# ============================================================================
# PROFILE EXAMPLES - Copy and uncomment as needed
# ============================================================================

# Development Profile - Frequent runs for testing
# SCRAPING_INTERVAL_MINUTES=1
# EMBEDDING_INTERVAL_MINUTES=1
# API_NEWS_INTERVAL_MINUTES=2
# CLEANUP_INTERVAL_HOURS=1

# Production Profile - Optimized for load
# SCRAPING_INTERVAL_MINUTES=30
# EMBEDDING_INTERVAL_MINUTES=15
# API_NEWS_INTERVAL_MINUTES=20
# CLEANUP_INTERVAL_HOURS=24

# Email Alerts
EMAIL_ALERTS_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENTS=

# Environment
ENVIRONMENT=development
DEBUG=true
