# News Scraper Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/newsdb
DB_POOL_MIN=5
DB_POOL_MAX=20

# Embedding Configuration (using open-source BGE model)
# No API key required - model runs locally
EMBEDDING_DEVICE=auto  # 'auto', 'cpu', or 'cuda'

# Optional: OpenAI Configuration (if you want to use both models)
# OPENAI_API_KEY=your_openai_api_key_here

# Scraping Configuration
SCRAPING_INTERVAL_HOURS=6
EMBEDDING_INTERVAL_MINUTES=30
CLEANUP_INTERVAL_DAYS=7

# Email Alerts (optional)
EMAIL_ALERTS_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENTS=admin@yoursite.com,support@yoursite.com

# Environment
ENVIRONMENT=development
DEBUG=true
