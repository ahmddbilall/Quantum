# Environment Variables for Market & Finance Page

# Finnhub API Key for real-time stock data
# Get your free API key at: https://finnhub.io/
# Free tier: 60 API calls/minute
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: Other financial data APIs
# NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
# NEXT_PUBLIC_IEX_CLOUD_API_KEY=your_iex_cloud_key

# Note: Binance WebSocket for crypto data doesn't require an API key
